{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/inject-rules.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\inject-rules.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/inject-rules.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\inject-rules.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/handle-prompt.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\handle-prompt.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
